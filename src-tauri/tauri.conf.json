{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crystal",
  "version": "0.2.4",
  "identifier": "com.anuj.crystal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crystal",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyOTU2OUJFMkQxQjkyM0MKUldROGtoc3R2bW1WMHBEYitmcGR2V21xWXZUNWgxR1lUcGtDek14dEhXYUJYTElHQ0RYTkp5SGMK",
      "endpoints": [
        "https://github.com/AnujLakhekar/Crystal-made-by-tuari-/releases/latest/download/latest.json"
      ]
    }
  }
}